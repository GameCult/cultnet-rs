{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GameCult/cultnet-rs/contracts/idunn.process-write-lease.schema.json",
  "title": "Idunn process write lease",
  "description": "Unsigned canonical positional root-file grant of state-write authority to one exact admitted process incarnation. It carries no route or traffic authority.",
  "type": "array",
  "prefixItems": [
    { "const": "idunn.process_write_lease.v1" },
    { "$ref": "#/$defs/identifier" },
    { "$ref": "#/$defs/sha256" },
    { "$ref": "#/$defs/sha256" },
    { "$ref": "#/$defs/identifier" },
    { "$ref": "#/$defs/sha256" },
    { "$ref": "#/$defs/sha256" },
    { "$ref": "#/$defs/identifier" },
    { "$ref": "#/$defs/sha256" },
    { "$ref": "#/$defs/identifier" },
    { "$ref": "#/$defs/sha256" },
    { "$ref": "#/$defs/sha256" },
    { "type": "integer", "minimum": 1 },
    { "type": "integer", "minimum": 1 }
  ],
  "minItems": 14,
  "maxItems": 14,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    }
  }
}
