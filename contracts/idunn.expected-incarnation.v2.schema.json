{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GameCult/cultnet-rs/contracts/idunn.expected-incarnation.v2.schema.json",
  "title": "Idunn Expected incarnation v2",
  "description": "Canonical positional Idunn-owned projection of one admitted deployment incarnation. It carries public source, recipe, artifact, runtime, signer, health, state, route, capability, and dependency facts without actuator paths or runner secrets. Capability declarations contain configuration-owned minimum capacity; provider presence owns observed capacity. Capability and dependency ordering are enforced by the typed contract.",
  "type": "array",
  "prefixItems": [
    { "const": "idunn.expected_incarnation.v2" },
    { "$ref": "#/$defs/identifier" },
    { "$ref": "#/$defs/sha256" },
    { "$ref": "#/$defs/identifier" },
    { "$ref": "#/$defs/sha256" },
    { "$ref": "#/$defs/repository" },
    { "$ref": "#/$defs/gitRevision" },
    { "$ref": "#/$defs/sha256" },
    { "$ref": "#/$defs/identifier" },
    { "$ref": "#/$defs/identifier" },
    { "$ref": "#/$defs/identifier" },
    { "$ref": "#/$defs/sha256" },
    { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
    { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    { "type": "boolean" },
    { "oneOf": [{ "$ref": "#/$defs/route" }, { "type": "null" }] },
    {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" },
      "maxItems": 256,
      "uniqueItems": true
    },
    {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" },
      "maxItems": 256,
      "uniqueItems": true
    }
  ],
  "minItems": 18,
  "maxItems": 18,
  "allOf": [
    {
      "oneOf": [
        {
          "prefixItems": [true, true, true, true, true, true, true, true, true, true, true, true, { "type": "null" }, { "type": "null" }]
        },
        {
          "prefixItems": [true, true, true, true, true, true, true, true, true, true, true, true, { "$ref": "#/$defs/identifier" }, { "$ref": "#/$defs/sha256" }]
        }
      ]
    },
    {
      "if": {
        "prefixItems": [true, true, true, true, true, true, true, true, true, true, true, true, { "type": "null" }]
      },
      "then": {
        "prefixItems": [true, true, true, true, true, true, true, true, true, true, true, true, true, true, { "const": false }]
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "repository": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9.-]+(?:/[A-Za-z0-9_.-]+){2,}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "capability": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/identifier" },
        { "$ref": "#/$defs/identifier" },
        { "$ref": "#/$defs/identifier" },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Configuration-owned minimum capacity required from a compatible provider. Observed capacity is owned and reported by provider presence."
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "route": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/identifier" },
        { "enum": ["http", "tcp"] },
        { "$ref": "#/$defs/endpoint" },
        { "$ref": "#/$defs/endpoint" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "dependency": {
      "type": "array",
      "prefixItems": [
        { "enum": ["bootstrap", "required", "optional", "shared-infrastructure", "private", "external-operator-binding"] },
        { "$ref": "#/$defs/identifier" },
        { "$ref": "#/$defs/identifier" },
        { "$ref": "#/$defs/identifier" },
        { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        { "enum": ["before-start", "before-promotion"] },
        { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        { "oneOf": [{ "enum": ["managed-incarnation", "external-operator-binding"] }, { "type": "null" }] },
        { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        { "oneOf": [{ "$ref": "#/$defs/endpoint" }, { "type": "null" }] }
      ],
      "minItems": 10,
      "maxItems": 10
    }
  }
}
